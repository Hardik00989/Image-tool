# Copy this file to .env.local and set your real values.

# Your real domain. Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: the verification code from Google Search Console (HTML tag method,
# the value of content="..."). Lets you verify the site and submit the sitemap.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
